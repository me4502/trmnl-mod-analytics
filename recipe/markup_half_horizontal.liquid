<div class="view view--half_horizontal">
  <div class="layout layout--col gap--small">
    {% if ok == false %}
      {% render "error_state" %}
    {% else %}
      <div class="grid {% if revenue.requested %}grid--cols-3{% else %}grid--cols-2{% endif %}">
        <div class="col">
          {% render 'stat_small', label: 'Downloads', value: totals.downloads, format: 'number' %}
        </div>
        {% if revenue.requested %}
          <div class="col">
            {% render 'stat_small', label: 'Balance', value: revenue.balanceUsd, format: 'currency' %}
          </div>
        {% endif %}
        <div class="col">
          {% render 'stat_small', label: 'Projects', value: totals.projects, format: 'number' %}
        </div>
      </div>

      <div class="columns">
        <div class="column">
          <span class="label label--underline">Projects</span>
          <div class="list gap" data-list-limit="true" data-list-hidden-count="true" data-list-max-height="95">
            {% for project in projects limit: 3 %}
              {% render 'project_row', project: project %}
            {% endfor %}
          </div>
        </div>

        {% if revenue.requested %}
          <div class="column">
            <span class="label label--underline">Revenue</span>
            <div class="item-list">
              {% render 'stat_small', label: 'All time', value: revenue.allTimeUsd, format: 'currency' %}
              {% render 'stat_small', label: 'Last month', value: revenue.lastMonthUsd, format: 'currency' %}
            </div>
            {% if revenue.unavailableReason %}
              <span class="label">{{ revenue.unavailableReason | truncate: 42 }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% render "title_bar" %}
</div>
