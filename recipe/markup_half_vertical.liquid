<div class="layout layout--col gap--medium">
  {% if ok == false %}
    {% render 'error_state', error: error, instance_title: instance_title, providerName: providerName %}
  {% else %}
    <div class="grid grid--cols-3 portrait:grid--cols-2">
      <div class="col portrait:col--span-2">
        <span class="label label--underline">Totals</span>
      </div>
      <div class="col">
        {% render 'stat_small', label: 'Downloads', value: totals.downloads, format: 'number', fit: true %}
      </div>
      <div class="col">
        {% render 'stat_small', label: 'Projects', value: totals.projects, format: 'number', fit: true %}
      </div>
    </div>

    {% if revenue.requested %}
      <div class="grid grid--cols-3 portrait:grid--cols-2">
        <div class="col portrait:col--span-2">
          <span class="label label--underline">Revenue</span>
        </div>
        <div class="col">
          {% render 'stat_small', label: 'Balance', value: revenue.balanceUsd, format: 'currency', fit: true %}
        </div>
        <div class="col">
          {% render 'stat_small', label: 'Last month', value: revenue.lastMonthUsd, format: 'currency', fit: true %}
        </div>
        <div class="col"></div>
        <div class="col">
          {% render 'stat_small', label: 'All time', value: revenue.allTimeUsd, format: 'currency', fit: true %}
        </div>
      </div>
    {% endif %}

    <div class="grid grid--cols-3 portrait:grid--cols-2">
      <div class="col portrait:col--span-2">
        <span class="label label--underline">Projects</span>
      </div>
      {% for project in projects limit: 4 %}
        {% if forloop.index0 == 2 %}
          <div class="col"></div>
        {% endif %}
        <div class="col">
          {% assign project_label = project.title | truncate: 24 | append: ' downloads' %}
          {% render 'stat_small', label: project_label, value: project.downloads, format: 'number', fit: true %}
        </div>
      {% endfor %}
    </div>

    {% if revenue.requested and revenue.unavailableReason %}
      <span class="label">{{ revenue.unavailableReason | truncate: 48 }}</span>
    {% endif %}
  {% endif %}
</div>

{% render 'title_bar', instance_title: instance_title, providerName: providerName %}
