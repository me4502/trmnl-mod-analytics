<div class="layout layout--col gap--medium">
  {% if ok == false %}
    {% render 'error_state', error: error, instance_title: instance_title, providerName: providerName %}
  {% else %}
    <div class="grid {% if revenue.requested %}grid--cols-3{% else %}grid--cols-2{% endif %}">
      <div class="col">
        {% render 'stat', label: 'Downloads', value: totals.downloads, format: 'number', fit: true, size: 'value--large' %}
      </div>
      {% if revenue.requested %}
        <div class="col">
          {% render 'stat', label: 'Balance', value: revenue.balanceUsd, format: 'currency', fit: true, size: 'value--large' %}
        </div>
      {% endif %}
      <div class="col">
        {% render 'stat', label: 'Projects', value: totals.projects, format: 'number', fit: true, size: 'value--large' %}
      </div>
    </div>

    <div class="columns">
      <div class="column">
        <span class="label label--underline">Per-project downloads</span>
        <div class="list gap" data-list-limit="true" data-list-hidden-count="true" data-list-max-height="245">
          {% for project in projects limit: 5 %}
            {% render 'project_row', project: project %}
          {% endfor %}
        </div>
      </div>

      {% if revenue.requested %}
        <div class="column">
          <span class="label label--underline">Revenue</span>
          <div class="list gap">
            {% render 'stat_small', label: 'All time', value: revenue.allTimeUsd, format: 'currency', fit: true, size: 'value--base' %}
            {% render 'stat_small', label: 'Last month', value: revenue.lastMonthUsd, format: 'currency', fit: true, size: 'value--base' %}
            {% render 'stat_small', label: 'Balance', value: revenue.balanceUsd, format: 'currency', fit: true, size: 'value--base' %}
          </div>
          {% if revenue.unavailableReason %}
            <span class="label">{{ revenue.unavailableReason | truncate: 64 }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

{% render 'title_bar', instance_title: instance_title, providerName: providerName %}
